{
  "name": "kavox-teaser",
  "version": "1.0.0",
  "private": true,
  "description": "Kavox KI-Angebot teaser (Remotion)",
  "scripts": {
    "dev": "remotion studio",
    "sfx": "node scripts/make-sfx.mjs",
    "still:logo": "remotion still KavoxTeaser-Screen out/still-logo.png --frame=385",
    "render:screen": "remotion render KavoxTeaser-Screen out/kavox-teaser-screen-sfx.mp4",
    "render:screen:silent": "remotion render KavoxTeaser-Screen out/kavox-teaser-screen-silent.mp4 --muted",
    "render:vertical": "remotion render KavoxTeaser-Vertical out/kavox-teaser-vertical-sfx.mp4",
    "render:vertical:silent": "remotion render KavoxTeaser-Vertical out/kavox-teaser-vertical-silent.mp4 --muted",
    "render:all": "npm run sfx && npm run render:screen && npm run render:screen:silent && npm run render:vertical && npm run render:vertical:silent",
    "typecheck": "tsc --noEmit",
    "render:story:screen": "remotion render KavoxStory-Screen out/kavox-story-screen-sfx.mp4",
    "render:story:screen:silent": "remotion render KavoxStory-Screen out/kavox-story-screen-silent.mp4 --muted",
    "render:story:vertical": "remotion render KavoxStory-Vertical out/kavox-story-vertical-sfx.mp4",
    "render:story:vertical:silent": "remotion render KavoxStory-Vertical out/kavox-story-vertical-silent.mp4 --muted",
    "render:story": "npm run sfx && npm run render:story:screen && npm run render:story:screen:silent && npm run render:story:vertical && npm run render:story:vertical:silent",
    "music": "node scripts/make-music.mjs",
    "render:reel": "remotion render KavoxReel-Full out/reel/kavox-reel-full.mp4",
    "render:reel:sfx-only": "remotion render KavoxReel-Full out/reel/kavox-reel-full-sfx-only.mp4 --props='{\"withMusic\":false,\"withSfx\":true}'",
    "render:reel:phases": "node scripts/cut-phases.mjs",
    "render:reel:all": "npm run music && npm run render:reel && npm run render:reel:sfx-only && npm run render:reel:phases"
  },
  "dependencies": {
    "@fontsource/plus-jakarta-sans": "^5.3.0",
    "@remotion/cli": "4.0.532",
    "@remotion/fonts": "4.0.532",
    "@remotion/motion-blur": "4.0.532",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "remotion": "4.0.532"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "5.9"
  }
}
