  "lines": [
    {
      "line": 1,
      "text": "Kennst du das? Feierabend… und auf dem Küchentisch warten noch drei Angebote.",
      "start": 0,
      "end": 6.52014,
      "segments": [
        {
          "start": 0,
          "end": 2.45048
        },
        {
          "start": 2.73671,
