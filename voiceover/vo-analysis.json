        },
        {
          "start": 6.06175,
          "end": 6.52014
        }
      ]
    },
    {
      "line": 2,
      "text": "Was wäre, wenn du sie einfach… sagst?",
      "start": 7.0017,
      "end": 9.64673,
      "segments": [
        {
          "start": 7.0017,
          "end": 8.77862
        },
        {
          "start": 9.06367,
          "end": 9.64673
        }
      ]
    },
    {
      "line": 3,
      "text": "Wohnzimmer, fünf mal vier, zwei sechzig hoch. Tapete runter, spachteln, streichen. Fertig.",
      "start": 10.159,
      "end": 16.5183,
      "segments": [
        {
          "start": 10.159,
          "end": 12.9306
        },
        {
          "start": 13.2774,
          "end": 15.6447
        },
        {
          "start": 15.9549,
          "end": 16.5183
        }
      ]
    },
    {
      "line": 4,
      "text": "Kavox rechnet die Flächen, zieht Fenster und Tür ab – und zeigt dir jeden Rechenweg. Kein Rätselraten mehr.",
      "start": 16.9405,
      "end": 24.1434,
      "segments": [
        {
          "start": 16.9405,
          "end": 20.1661
        },
        {
          "start": 20.3169,
          "end": 22.0762
        },
        {
          "start": 22.3609,
          "end": 22.5951
        },
        {
          "start": 22.815,
          "end": 24.1434
        }
      ]
    },
    {
      "line": 5,
      "text": "Die Summe steht, noch bevor du die Leiter einpackst. Der Kunde unterschreibt direkt vor Ort.",
      "start": 24.5435,
      "end": 29.9891,
      "segments": [
        {
          "start": 24.5435,
          "end": 27.4433
        },
        {
          "start": 27.792,
          "end": 28.7867
        },
        {
          "start": 28.9137,
          "end": 29.9891
        }
      ]
    },
    {
      "line": 6,
      "text": "Ein Tipp – und alles liegt am Rechner. Automatisch geprüft. Als sauberes PDF. Raus damit.",
      "start": 30.3813,
      "end": 36.8976,
      "segments": [
        {
          "start": 30.3813,
          "end": 30.8758
